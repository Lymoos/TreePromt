# Домен, на который смотрит DNS VPS. Caddy сам получит HTTPS-сертификат.
DOMAIN=prompttree.example.com

# Сгенерировать: openssl rand -hex 24  (только hex, чтобы не экранировать в URL)
POSTGRES_PASSWORD=

# Сгенерировать: openssl rand -hex 32
JWT_SECRET=

# Ключ Google AI Studio (только здесь, на сервере). Без него «Структурировать» выключено.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# AI_DAILY_LIMIT=200
